# Copy this file to backend/.env on your own computer to change a setting.
# backend/.env is ignored by Git. Never put a real key in THIS file or in any file that gets committed.
# Every setting below also has a default in backend/app/config.py, so the server runs without a .env.

# ---- Chatbot (Silo) ----
# Which provider answers. "placeholder" is the only one built: a fixed answer, no AI, no cost.
CHAT_PROVIDER=placeholder
# Only for a future AI provider (README: "Plugging in an AI later"). Real AI calls can cost money.
# Leave it commented out until a provider is built. Read from the environment only, never in code.
# GEMINI_API_KEY=
# Guards that matter once a real AI is connected:
# CHAT_MAX_QUESTION_LENGTH=200
# CHAT_IP_MAX_QUESTIONS=15
# CHAT_IP_WINDOW_SECONDS=600
# CHAT_TIMEOUT_SECONDS=15

# ---- Weather (Open-Meteo, no key needed) ----
# WEATHER_CACHE_MINUTES=10
# WEATHER_TIMEOUT_SECONDS=8
