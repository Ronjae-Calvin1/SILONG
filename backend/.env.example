# Copy this file to backend/.env on your own computer to change a setting.
# backend/.env is ignored by Git. Never put a real key in THIS file or in any file that gets committed.
# Every setting below also has a default in backend/app/config.py, so the server runs without a .env.
# The backend reads this file automatically at start. A variable already set in the real environment wins over it.

# ---- Which websites may call the backend (CORS, update 16) ----
# SILONG runs as two frontends and one backend: the user site on 5173, the admin console on 5174, the backend on 8000.
# A browser may read the backend's answers only from the origins listed here (comma separated, no path, no trailing "/").
# Not set (or empty) = these four, which is right for running everything on your own computer:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# When the sites go online, list their real addresses instead, for example:
# CORS_ORIGINS=https://silong.example.ph,https://admin.silong.example.ph
# "*" lets ANY website call the backend from a browser. It works only if you write it here on purpose,
# and the backend then logs a warning at start. Do not use it once real Admin accounts exist.
# CORS_ORIGINS=*

# ---- Database ----
# Default is the typhoon.db file in the folder you run from. A separate file is handy for demo data.
# DATABASE_URL=sqlite:///./demo.db

# ---- Chatbot (Silo) ----
# Which provider answers. "placeholder" is the only one built: a fixed answer, no AI, no cost.
CHAT_PROVIDER=placeholder
# Only for a future AI provider (README: "Plugging in an AI later"). Real AI calls can cost money.
# Leave it commented out until a provider is built. Read from the environment only, never in code.
# GEMINI_API_KEY=
# Guards that matter once a real AI is connected:
# CHAT_MAX_QUESTION_LENGTH=200
# CHAT_IP_MAX_QUESTIONS=15
# CHAT_IP_WINDOW_SECONDS=600
# CHAT_TIMEOUT_SECONDS=15

# ---- Weather (Open-Meteo, no key needed) ----
# WEATHER_CACHE_MINUTES=10
# WEATHER_TIMEOUT_SECONDS=8

# ---- Operations (part 5) ----
# A phone blocked after 3 false reports is unblocked after this many days. 0 = never.
# BLOCK_EXPIRES_DAYS=0
# The background cleanup runs every this many minutes. 0 = off.
# PURGE_INTERVAL_MINUTES=60
# Wrong current passwords allowed when changing a password (per person, per IP) in the window:
# PASSWORD_CHANGE_MAX_WRONG=5
# PASSWORD_CHANGE_IP_MAX_WRONG=20
# PASSWORD_CHANGE_WINDOW_SECONDS=600

# ---- Admin console (update 14) ----
# "Handled N reports today" counts from local midnight: hours ahead of UTC (Philippines = 8, no daylight saving).
# ADMIN_DAY_UTC_OFFSET_HOURS=8
