# Copy this file to ".env" (same folder) and fill in your values.
# Where the backend is. Same value as the user site.
VITE_API_URL=http://127.0.0.1:8000/api
# Free key: https://cloud.maptiler.com/account/keys/ . Empty = plain OpenStreetMap map.
VITE_MAPTILER_KEY=
# Your custom map ID from MapTiler Cloud, or streets-v2 for the stock style.
VITE_MAPTILER_STYLE=streets-v2
