+++ b/backend/app/report_routes.py
@@ -0,0 +1,168 @@
+"""
+Help requests and hazard reports.
+
+    POST /api/reports                          public, X-Phone-Id   send a help request or a hazard
+    GET  /api/reports/mine                     public, X-Phone-Id   this phone's own reports and their status
+    GET  /api/hazards/nearby                   public               hazards within the near-me range (approximate spot)
+    GET  /api/responder/reports                responder, super_admin   list for the responder screens (poll ~10 s)
+    POST /api/responder/reports/{id}/take      responder, super_admin
+    POST /api/responder/reports/{id}/resolve   responder, super_admin   body: what_was_done
+    POST /api/responder/reports/{id}/mark-false responder, super_admin  body: reason
+    POST /api/responder/reports/{id}/verify    responder, super_admin   hazards only
+
+The public endpoints have no sign-in: the protection is the phone ID, the
+per-phone and per-IP limits (rate_limit.py) and the block after false reports.
+Responder actions are audited (audit.py).
+"""
+from datetime import timezone
+from typing import List, Literal, Optional
+
+from fastapi import APIRouter, Depends, Header, HTTPException, Query, Request, Response
+from sqlalchemy.orm import Session
+
+from . import report_service
+from .auth import require_responder
+from .database import get_db
+from .models import User
+from .rate_limit import read_limiter, report_limiter
+from .report_schemas import (
+    MarkFalseIn, MyReportOut, NearbyHazardOut, ReportIn, ReportSentOut, ResolveIn,
+    ResponderListOut, ResponderReportOut, my_report_out, responder_item_out, responder_list_out,
+)
+
+router = APIRouter(tags=["reports"])
+
+
+def _ip(request: Request) -> str:
+    return request.client.host if request.client else "unknown"
+
+
+def required_phone(x_phone_id: Optional[str] = Header(default=None)) -> str:
+    """The hashed phone ID from the X-Phone-Id header. 400 when it is missing or malformed."""
+    return report_service.phone_hash_from_header(x_phone_id, required=True)
+
+
+def optional_phone(x_phone_id: Optional[str] = Header(default=None)) -> Optional[str]:
+    return report_service.phone_hash_from_header(x_phone_id, required=False)
+
+
+def _read_limit(request: Request, phone: Optional[str]) -> None:
+    wait = read_limiter.check(_ip(request), phone)
+    if wait is not None:
+        raise HTTPException(
+            status_code=429,
+            detail=f"Too many requests. Please try again in {wait} second(s).",
+            headers={"Retry-After": str(wait)},
+        )
+
+
+# ---- Public ----
+
+@router.post("/api/reports", response_model=ReportSentOut, status_code=201)
+def send_report(
+    payload: ReportIn, request: Request, response: Response,
+    phone: str = Depends(required_phone), db: Session = Depends(get_db),
+):
+    """Send a help request ("kind": "help") or a hazard report ("kind": "hazard"). Field rules are in ReportIn."""
+    if report_service.is_blocked(db, phone):
+        raise HTTPException(
+            status_code=403,
+            detail="This phone can no longer send reports, because several of its reports were marked false. "
+                   "In an emergency, call 911.",
+        )
+    # Limits after validation (the body is already checked) and the block, so a mistake does not use up the allowance.
+    hit = report_limiter.check(_ip(request), phone, payload.kind)
+    if hit:
+        scope, wait = hit
+        if scope == "cooldown":
+            msg = f"You just sent a report. Please wait {wait} seconds before sending another one."
+        else:
+            minutes = max(1, round(wait / 60))
+            msg = ("Too many reports from this phone." if scope == "phone" else "Too many reports from your connection.")
+            msg += f" Please try again in about {minutes} minute(s). In an emergency, call 911."
+        raise HTTPException(status_code=429, detail=msg, headers={"Retry-After": str(wait)})
+
+    row, created = report_service.create_report(
+        db, payload.kind, payload.latitude, payload.longitude, payload.contact, payload.note, phone, _ip(request),
+    )
+    db.commit()
+    db.refresh(row)
+    if not created:
+        response.status_code = 200
+    status = report_service.PUBLIC_STATUS[row.status]
+    if payload.kind == report_service.HELP:
+        message = "Your request was sent to the responders. If it is an emergency, also call 911."
+    elif created:
+        message = "Thank you. Your hazard report was received."
+    else:
+        message = "You already reported this hazard. Thank you."
+    return ReportSentOut(
+        id=row.id, kind=row.kind, status=status, label=report_service.PUBLIC_LABEL[status],
+        created_at=row.created_at.replace(tzinfo=timezone.utc), message=message,
+    )
+
+
+@router.get("/api/reports/mine", response_model=List[MyReportOut])
+def my_reports(request: Request, phone: str = Depends(required_phone), db: Session = Depends(get_db)):
+    """This phone's own reports, newest first, with a status: New, Being handled or Resolved."""
+    _read_limit(request, phone)
+    return [my_report_out(d) for d in report_service.reports_of_phone(db, phone)]
+
+
+@router.get("/api/hazards/nearby", response_model=List[NearbyHazardOut])
+def nearby_hazards(
+    request: Request,
+    latitude: float = Query(ge=-90, le=90),
+    longitude: float = Query(ge=-180, le=180),
+    phone: Optional[str] = Depends(optional_phone),
+    db: Session = Depends(get_db),
+):
+    """
+    Hazards within the near-me range (config.NEAR_ME_KM) that are Unconfirmed or
+    Verified, as an approximate spot with a status and no details. The position
+    you send is used for this answer only and is not stored.
+    """
+    _read_limit(request, phone)
+    return [NearbyHazardOut(**h) for h in report_service.nearby_hazards(db, latitude, longitude)]
+
+
+# ---- Responders and Super admins ----
+
+@router.get("/api/responder/reports", response_model=ResponderListOut)
+def responder_reports(
+    include_closed: bool = Query(False, description="Also list resolved and false reports"),
+    kind: Optional[Literal["help", "hazard"]] = Query(None),
+    user: User = Depends(require_responder),
+    db: Session = Depends(get_db),
+):
+    """
+    Poll this about every `refresh_seconds` (10). `has_new_help` is true while
+    any help request is still New: show the red "Needs help" alert. Open reports
+    only, unless include_closed is set. A hazard is one line for all reports
+    about the same place.
+    """
+    return responder_list_out(report_service.responder_list(db, include_closed=include_closed, kind=kind))
+
+
+@router.post("/api/responder/reports/{report_id}/take", response_model=ResponderReportOut)
+def take_report(report_id: int, request: Request, user: User = Depends(require_responder), db: Session = Depends(get_db)):
+    """Take it: New -> Being handled. 409 if someone else already has it. Safe to call twice."""
+    return responder_item_out(report_service.take(db, user, report_id, request))
+
+
+@router.post("/api/responder/reports/{report_id}/resolve", response_model=ResponderReportOut)
+def resolve_report(report_id: int, payload: ResolveIn, request: Request, user: User = Depends(require_responder), db: Session = Depends(get_db)):
+    """Resolve. Needs `what_was_done`. The sender then sees Resolved."""
+    return responder_item_out(report_service.resolve(db, user, report_id, payload.what_was_done, request))
+
+
+@router.post("/api/responder/reports/{report_id}/mark-false", response_model=ResponderReportOut)
+def mark_report_false(report_id: int, payload: MarkFalseIn, request: Request, user: User = Depends(require_responder), db: Session = Depends(get_db)):
+    """Mark false. Needs a `reason`. A phone with 3 false reports is blocked from sending reports."""
+    return responder_item_out(report_service.mark_false(db, user, report_id, payload.reason, request))
+
+
+@router.post("/api/responder/reports/{report_id}/verify", response_model=ResponderReportOut)
+def verify_report(report_id: int, request: Request, user: User = Depends(require_responder), db: Session = Depends(get_db)):
+    """Verify a hazard: the public then sees it as Verified. Hazards only. Safe to call twice."""
+    return responder_item_out(report_service.verify(db, user, report_id, request))
diff --git a/backend/app/report_schemas.py b/backend/app/report_schemas.py
new file mode 100644
index 0000000..c6ebbb7
--- /dev/null
+++ b/backend/app/report_schemas.py
@@ -0,0 +1,160 @@
+"""Request/response shapes for help requests and hazard reports."""
+from datetime import datetime, timezone
+from typing import List, Literal, Optional
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator
+
+from . import config
+from .schemas import _clean_text
+
+ACTION_TEXT_MIN, ACTION_TEXT_MAX = 3, 500
+
+
+def _utc(dt: Optional[datetime]) -> Optional[datetime]:
+    """Times are stored as naive UTC; send them out marked as UTC."""
+    return dt.replace(tzinfo=timezone.utc) if dt is not None else None
+
+
+class ReportIn(BaseModel):
+    """
+    What a phone may send. Nothing else is accepted: no name, no photo (a field
+    that is not listed here is refused with 422). The phone ID goes in the
+    X-Phone-Id header, not in the body.
+    """
+    model_config = ConfigDict(extra="forbid")
+
+    kind: Literal["help", "hazard"]
+    latitude: float = Field(allow_inf_nan=False)
+    longitude: float = Field(allow_inf_nan=False)
+    contact: Optional[str] = None  # optional; only responders and Super admins ever see it
+    note: Optional[str] = None  # optional, short
+
+    @field_validator("contact")
+    @classmethod
+    def _contact_clean(cls, v):
+        return _clean_text(v, config.REPORT_CONTACT_MAX, "Contact")
+
+    @field_validator("note")
+    @classmethod
+    def _note_clean(cls, v):
+        return _clean_text(v, config.REPORT_NOTE_MAX, "Note")
+
+    @model_validator(mode="after")
+    def _inside_city(self):
+        south, west, north, east = config.BATANGAS_CITY_BBOX
+        if not (south <= self.latitude <= north and west <= self.longitude <= east):
+            raise ValueError(
+                "That location is outside Batangas City "
+                f"(latitude {south} to {north}, longitude {west} to {east})."
+            )
+        return self
+
+
+class ReportSentOut(BaseModel):
+    id: int
+    kind: Literal["help", "hazard"]
+    status: Literal["new", "being_handled", "resolved"]
+    label: str
+    created_at: datetime
+    message: str
+
+
+class MyReportOut(BaseModel):
+    """A phone's own report. No contact, no handler, no reason: only a status."""
+    id: int
+    kind: Literal["help", "hazard"]
+    status: Literal["new", "being_handled", "resolved"]
+    label: str  # New | Being handled | Resolved
+    latitude: float
+    longitude: float
+    note: Optional[str] = None
+    created_at: datetime
+    updated_at: datetime
+
+
+class NearbyHazardOut(BaseModel):
+    """What the public sees of a hazard: an approximate spot and a status. Nothing else."""
+    id: int
+    latitude: float  # approximate
+    longitude: float  # approximate
+    status: Literal["unconfirmed", "verified"]
+    label: str  # Unconfirmed | Verified
+
+
+class ResolveIn(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    what_was_done: str
+
+    @field_validator("what_was_done")
+    @classmethod
+    def _clean(cls, v: str) -> str:
+        v = " ".join(v.split())
+        if not (ACTION_TEXT_MIN <= len(v) <= ACTION_TEXT_MAX):
+            raise ValueError(f"Say what was done ({ACTION_TEXT_MIN} to {ACTION_TEXT_MAX} characters).")
+        return v
+
+
+class MarkFalseIn(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    reason: str
+
+    @field_validator("reason")
+    @classmethod
+    def _clean(cls, v: str) -> str:
+        v = " ".join(v.split())
+        if not (ACTION_TEXT_MIN <= len(v) <= ACTION_TEXT_MAX):
+            raise ValueError(f"Give a reason ({ACTION_TEXT_MIN} to {ACTION_TEXT_MAX} characters).")
+        return v
+
+
+class ResponderReportOut(BaseModel):
+    """One line of the responder list: a help request, or a hazard (all reports about the same place)."""
+    id: int  # use this id in the action endpoints
+    kind: Literal["help", "hazard"]
+    status: Literal["new", "being_handled", "resolved", "false"]
+    is_new_help: bool  # a help request nobody has taken yet (the red alert)
+    latitude: float  # exact
+    longitude: float  # exact
+    contacts: List[str]
+    notes: List[str]
+    created_at: datetime
+    updated_at: datetime
+    taken_by: Optional[str] = None
+    closed_by: Optional[str] = None
+    resolution_note: Optional[str] = None
+    false_reason: Optional[str] = None
+    verified: bool
+    verified_by: Optional[str] = None
+    hazard_state: Optional[Literal["pending", "unconfirmed", "verified"]] = None  # hazards only
+    phones: int  # different phones that sent it
+    report_count: int
+
+
+class ResponderListOut(BaseModel):
+    server_time: datetime
+    refresh_seconds: int  # poll about this often
+    new_help_count: int  # help requests nobody has taken yet
+    has_new_help: bool  # true = show the red "Needs help" alert
+    latest_report_id: Optional[int] = None
+    items: List[ResponderReportOut]
+
+
+def _out_dt(d: dict, *names: str) -> dict:
+    for n in names:
+        d[n] = _utc(d.get(n))
+    return d
+
+
+def responder_item_out(item: dict) -> ResponderReportOut:
+    return ResponderReportOut(**_out_dt(dict(item), "created_at", "updated_at"))
+
+
+def responder_list_out(data: dict) -> ResponderListOut:
+    data = dict(data)
+    data["server_time"] = _utc(data["server_time"])
+    data["items"] = [responder_item_out(i) for i in data["items"]]
+    return ResponderListOut(**data)
+
+
+def my_report_out(d: dict) -> MyReportOut:
+    return MyReportOut(**_out_dt(dict(d), "created_at", "updated_at"))
