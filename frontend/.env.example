# Copy this file to ".env" (same folder) and fill in your values.
# Free key: https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=
# Your custom map ID from MapTiler Cloud (the part between /maps/ and /style.json).
# Use streets-v2 to try the stock style instead.
VITE_MAPTILER_STYLE=streets-v2
